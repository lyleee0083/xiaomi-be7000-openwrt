config system
	option hostname 'BE7000'
	option timezone 'CST-8'
	option zonename 'Asia/Shanghai'
	option ttylogin '0'
	option log_size '64'
	option urandom_seed '0'
	option zram_comp_algo 'lzo'
	option zram_comp_streams '4'

config timeserver 'ntp'
	option enabled '1'
	option enable_server '0'
	option use_dhcp '0'
	list server 'cn.pool.ntp.org'

config led 'led_wan'
	option name 'WAN'
	option sysfs 'white:network'
	option default '0'
	option trigger 'none'

config led 'led_network_amber'
	option name 'Network Amber'
	option sysfs 'amber:network'
	option default '0'
	option trigger 'none'

config led 'led_system_white'
	option name 'System White'
	option sysfs 'white:system'
	option default '0'
	option trigger 'none'

config led 'led_system_amber'
	option name 'System Amber'
	option sysfs 'amber:system'
	option default '0'
	option trigger 'none'

config led 'led_aiot'
	option name 'AIoT'
	option sysfs 'white:aiot'
	option default '0'
	option trigger 'none'

config led 'led_wan_port'
	option name 'WAN port'
	option sysfs '90000.mdio-1:01:green:wan'
	option trigger 'netdev'
	option dev 'wan'
	option mode 'link_10 link_100 link_1000 link_2500 tx rx'
	option default '0'

config led 'led_lan1_port'
	option name 'LAN1 port'
	option sysfs '90000.mdio-1:02:green:lan-1'
	option trigger 'netdev'
	option dev 'lan1'
	option mode 'link_10 link_100 link_1000 link_2500 tx rx'
	option default '0'

config led 'led_lan2_port'
	option name 'LAN2 port'
	option sysfs '90000.mdio-1:03:green:lan-2'
	option trigger 'netdev'
	option dev 'lan2'
	option mode 'link_10 link_100 link_1000 link_2500 tx rx'
	option default '0'

config led 'led_lan3_port'
	option name 'LAN3 port'
	option sysfs '90000.mdio-1:04:green:lan-3'
	option trigger 'netdev'
	option dev 'lan3'
	option mode 'link_10 link_100 link_1000 link_2500 tx rx'
	option default '0'
