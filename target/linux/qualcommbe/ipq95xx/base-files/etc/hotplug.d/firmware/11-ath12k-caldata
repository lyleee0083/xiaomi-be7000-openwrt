#!/bin/sh

[ -e "/lib/firmware/$FIRMWARE" ] && exit 0

. /lib/functions/caldata.sh

[ "$(board_name)" = "xiaomi,be7000" ] || exit 0

case "$FIRMWARE" in
"ath12k/QCN9274/hw1.0/cal-pci-0002:01:00.0.bin"|\
"ath12k/QCN9274/hw2.0/cal-pci-0002:01:00.0.bin")
	if [ -n "$(find_mtd_index 0:art)" ]; then
		caldata_extract "0:art" 0x65000 0x2d000
	else
		caldata_extract "0:ART" 0x65000 0x2d000
	fi
	;;
*)
	exit 1
	;;
esac
