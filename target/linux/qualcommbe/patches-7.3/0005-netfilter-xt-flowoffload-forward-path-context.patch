From: lean <chenlin@fnnas.com>
Subject: [PATCH] netfilter: xt_FLOWOFFLOAD: use the forward path context API

Keep the legacy flow offload target compatible with the PPE forward path API.

Signed-off-by: lean <chenlin@fnnas.com>

--- a/net/netfilter/xt_FLOWOFFLOAD.c
+++ b/net/netfilter/xt_FLOWOFFLOAD.c
@@ -363,6 +363,9 @@
 {
 	const void *daddr = &ct->tuplehash[!dir].tuple.src.u3;
 	struct net_device *dev = dst_cache->dev;
+	struct net_device_path_ctx ctx = {
+		.dev = dev,
+	};
 	struct neighbour *n;
 	u8 nud_state;
 
@@ -383,7 +386,8 @@
 		return -1;
 
 out:
-	return dev_fill_forward_path(dev, ha, stack);
+	ether_addr_copy(ctx.daddr, ha);
+	return dev_fill_forward_path(&ctx, stack);
 }
 
 static void nf_dev_forward_path(struct nf_flow_route *route,
@@ -397,8 +401,10 @@
 	unsigned char ha[ETH_ALEN];
 	int i;
 
-	if (nf_dev_fill_forward_path(route, dst, ct, dir, ha, &stack) >= 0)
+	if (nf_dev_fill_forward_path(route, dst, ct, dir, ha, &stack) >= 0) {
 		nf_dev_path_info(&stack, &info, ha);
+		dev_fill_forward_path_release(&stack);
+	}
 
 	/* The xmit path looks the output device up by index for every xmit
 	 * type, so it has to be set even when the forward path is unknown.
